    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.18.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-summary-helper",
    "local",
    "privacy"
  ],
  "homepage": "https://ai-summary-helper.byphil.eu/blog/ai-apps-mcp.html",
  "repository": {
