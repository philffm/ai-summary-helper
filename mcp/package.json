{
  "name": "aish-mcp",
  "version": "0.1.0",
  "description": "Local relay that exposes your AI Summary Helper library to any MCP-capable app on this computer (Claude Desktop, LM Studio, Cursor, VS Code, Jan, …). No library data leaves your device; the relay stores and logs nothing of what it forwards.",
