{
  "manifest_version": 3,
  "name": "__MSG_extensionNameFirefox__",
  "default_locale": "en",
  "version": "2.2.47",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "notifications",
    "alarms",
    "unlimitedStorage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "file:///*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "inPage.css",
        "services.json",
        "lib/pdf.mjs",
        "lib/pdf.worker.mjs",
        "lib/openjpeg_nowasm_fallback.js",
        "lib/jbig2_nowasm_fallback.js"
      ],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ]
}
