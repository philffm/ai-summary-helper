{
  "name": "aish-website-i18n",
  "private": true,
  "version": "1.0.0",
  "description": "CI-only tooling that translates and market-adapts the AI Summary Helper website. Not part of the site itself — the site remains plain HTML/CSS/JS with no build step.",
  "type": "module",
  "scripts": {
    "site:build": "node scripts/build-site.mjs",
    "translate": "npm run site:build && node scripts/translate.mjs",
    "translate:dry-run": "npm run site:build && node scripts/translate.mjs --dry-run",
    "build": "node plugin/scripts/build.js",
    "build:chrome": "node plugin/scripts/build.js chrome",
    "build:android": "node plugin/scripts/build.js android",
    "build:firefox": "node plugin/scripts/build.js firefox",
    "build:ios": "node plugin/scripts/build.js ios",
    "build:release": "./plugin/build.sh"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  }
}
