{
  "name": "aish-website-i18n",
  "private": true,
  "version": "1.0.0",
  "description": "Repo tooling: site build + i18n translation (CI) and the jsdom test-suite for the extension (npm test). The site itself remains plain HTML/CSS/JS with no build step.",
  "type": "module",
  "scripts": {
    "build": "node plugin/scripts/build.js chrome",
    "build:all": "node plugin/scripts/build.js",
    "build:chrome": "node plugin/scripts/build.js chrome",
    "build:firefox": "node plugin/scripts/build.js firefox",
    "build:android": "node plugin/scripts/build.js android",
    "build:ios": "node plugin/scripts/build.js ios",
    "privacy:build": "node scripts/privacy-md.mjs",
    "site:build": "node scripts/privacy-md.mjs && node scripts/build-site.mjs && node scripts/seo.mjs",
    "translate": "npm run site:build && node scripts/translate.mjs && node scripts/seo.mjs",
    "translate:dry-run": "npm run site:build && node scripts/translate.mjs --dry-run",
    "test": "node plugin/tests/run.mjs",
    "test:all": "node plugin/tests/run.mjs --all",
    "test:release": "node plugin/tests/run.mjs --release && node scripts/feed-i18n.mjs check",
    "lint": "eslint plugin/src"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2"
  }
}
