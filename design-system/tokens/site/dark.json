{
  "site": {
    "semantic": {
      "surface": {
        "bg": {
          "$type": "color",
          "$value": "{site.primitive.palette.gray-990}",
          "$description": "Page background (dark by default)."
        },
        "bg-raised": {
          "$type": "color",
          "$value": "{site.primitive.palette.gray-950}",
          "$description": "Raised band or section above bg."
        },
        "bg-sunken": {
          "$type": "color",
          "$value": "{site.primitive.palette.gray-900}",
          "$description": "Sunken band or section below bg."
        },
        "surface-1": {
          "$type": "color",
          "$value": "{color.white}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.05
            }
          },
          "$description": "Card surface, level 1."
        },
        "surface-1-strong": {
          "$type": "color",
          "$value": "{color.white}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.08
            }
          },
          "$description": "Card surface, level 1, more opaque (on busy backgrounds)."
        },
        "surface-2": {
          "$type": "color",
          "$value": "{color.white}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.025
            }
          },
          "$description": "Card surface, level 2 (card inside a card)."
        },
        "surface-2-strong": {
          "$type": "color",
          "$value": "{color.black}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.14
            }
          },
          "$description": "Card surface, level 2, more opaque."
        },
        "input-bg": {
          "$type": "color",
          "$value": "{color.black}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.25
            }
          },
          "$description": "Field background."
        },
        "card-shadow": {
          "$type": "shadow",
          "$value": "{color.black}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.6
            }
          },
          "$description": "Shadow of cards."
        },
        "sheen-strong": {
          "$type": "color",
          "$value": "{color.white}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.35
            }
          },
          "$description": "White sheen on icons and glossy tiles."
        },
        "glow-accent": {
          "$type": "color",
          "$value": "{brand.accent.450}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.16
            }
          },
          "$description": "Accent glow behind the hero."
        },
        "glow-highlight": {
          "$type": "color",
          "$value": "{brand.highlight.400}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.12
            }
          },
          "$description": "Highlight glow behind the hero."
        },
        "grain-dot": {
          "$type": "color",
          "$value": "{color.white}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.035
            }
          },
          "$description": "Dot colour of the grain texture."
        },
        "surface-bar": {
          "$type": "color",
          "$value": "{color.ink.nav}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.72
            }
          },
          "$description": "Background of fixed bars (pane headers, toolbars) above scrolling content."
        },
        "surface-bar-solid": {
          "$type": "color",
          "$value": "{color.ink.nav}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.97
            }
          },
          "$description": "Opaque header bar (menu open, reduced transparency)."
        }
      },
      "text": {
        "text": {
          "$type": "color",
          "$value": "{site.primitive.palette.gray-50}",
          "$description": "Body text and headlines."
        },
        "text-muted": {
          "$type": "color",
          "$value": "{site.primitive.palette.gray-300}",
          "$description": "Least important readable text: hints, meta lines, timestamps, placeholders (≥ 4.5:1)."
        }
      },
      "accent": {
        "accent": {
          "$type": "color",
          "$value": "{site.primitive.palette.brand-accent-400}",
          "$description": "Brand action colour: primary buttons, selected states, links on controls, focus ring, progress."
        },
        "accent-text": {
          "$type": "color",
          "$value": "{site.primitive.palette.brand-accent-300}",
          "$description": "Accent as text (links, kickers) at ≥ 4.5:1."
        },
        "accent-fill": {
          "$type": "color",
          "$value": "{site.primitive.palette.brand-accent-350}",
          "$description": "Accent button fill."
        },
        "accent-fill-hi": {
          "$type": "color",
          "$value": "{site.primitive.palette.brand-accent-300}",
          "$description": "Accent button fill on hover."
        },
        "on-accent": {
          "$type": "color",
          "$value": "{site.primitive.palette.navy-950}",
          "$description": "Text and icons on an accent fill (primary button, selected pill, active nav item)."
        },
        "highlight": {
          "$type": "color",
          "$value": "{site.primitive.palette.brand-highlight-400}",
          "$description": "Highlight brand colour (second brand colour)."
        },
        "highlight-text": {
          "$type": "color",
          "$value": "{site.primitive.palette.brand-highlight-300}",
          "$description": "Highlight as text at ≥ 4.5:1."
        },
        "highlight-fill": {
          "$type": "color",
          "$value": "{site.primitive.palette.brand-highlight-300}",
          "$description": "Highlight button fill."
        },
        "highlight-fill-hover": {
          "$type": "color",
          "$value": "{site.primitive.palette.brand-highlight-400}",
          "$description": "Highlight button fill on hover."
        },
        "on-highlight": {
          "$type": "color",
          "$value": "{site.primitive.palette.navy-950}",
          "$description": "Text on highlight fills."
        },
        "highlight-subtle": {
          "$type": "color",
          "$value": "{brand.highlight.400}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.08
            }
          },
          "$description": "Faint highlight tint."
        },
        "highlight-border": {
          "$type": "color",
          "$value": "{brand.highlight.400}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.5
            }
          },
          "$description": "Border in highlight colour."
        }
      },
      "feedback": {
        "danger": {
          "$type": "color",
          "$value": "{site.primitive.palette.red-400}",
          "$description": "Errors and destructive actions on the website."
        }
      },
      "outline": {
        "border-subtle": {
          "$type": "color",
          "$value": "{color.white}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.07
            }
          },
          "$description": "Hairline borders and dividers."
        },
        "border-medium": {
          "$type": "color",
          "$value": "{color.white}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.13
            }
          },
          "$description": "Borders of chips, pills and fields."
        },
        "border-strong": {
          "$type": "color",
          "$value": "{color.white}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.2
            }
          },
          "$description": "Borders that must be seen (focus groups, outlined buttons)."
        }
      },
      "elevation": {
        "shadow-poster": {
          "$type": "shadow",
          "$value": "{color.black}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.5
            }
          },
          "$description": "Shadow of video posters and device mocks."
        }
      }
    },
    "component": {}
  }
}
