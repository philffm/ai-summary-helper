{
  "site": {
    "semantic": {
      "surface": {
        "bg": {
          "$type": "color",
          "$value": "{site.primitive.palette.stone-50}",
          "$description": "Page background (dark by default)."
        },
        "bg-raised": {
          "$type": "color",
          "$value": "{site.primitive.palette.stone-0}",
          "$description": "Raised band or section above bg."
        },
        "bg-sunken": {
          "$type": "color",
          "$value": "{site.primitive.palette.stone-150}",
          "$description": "Sunken band or section below bg."
        },
        "surface-1": {
          "$type": "color",
          "$value": "{color.graphite.ink}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.035
            }
          },
          "$description": "Card surface, level 1."
        },
        "surface-1-strong": {
          "$type": "color",
          "$value": "{color.graphite.ink}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.06
            }
          },
          "$description": "Card surface, level 1, more opaque (on busy backgrounds)."
        },
        "surface-2": {
          "$type": "color",
          "$value": "{color.graphite.ink}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.02
            }
          },
          "$description": "Card surface, level 2 (card inside a card)."
        },
        "surface-2-strong": {
          "$type": "color",
          "$value": "{color.graphite.ink}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.04
            }
          },
          "$description": "Card surface, level 2, more opaque."
        },
        "input-bg": {
          "$type": "color",
          "$value": "{site.primitive.palette.stone-0}",
          "$description": "Field background."
        },
        "card-shadow": {
          "$type": "shadow",
          "$value": "{color.graphite.ink}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.14
            }
          },
          "$description": "Shadow of cards."
        },
        "sheen-strong": {
          "$type": "color",
          "$value": "{color.white}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.7
            }
          },
          "$description": "White sheen on icons and glossy tiles."
        },
        "glow-accent": {
          "$type": "color",
          "$value": "{brand.accent.700}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.09
            }
          },
          "$description": "Accent glow behind the hero."
        },
        "glow-highlight": {
          "$type": "color",
          "$value": "{brand.highlight.750}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.08
            }
          },
          "$description": "Highlight glow behind the hero."
        },
        "grain-dot": {
          "$type": "color",
          "$value": "{color.graphite.ink}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.05
            }
          },
          "$description": "Dot colour of the grain texture."
        },
        "surface-bar": {
          "$type": "color",
          "$value": "{color.stone.50}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.82
            }
          },
          "$description": "Background of fixed bars (pane headers, toolbars) above scrolling content."
        },
        "surface-bar-solid": {
          "$type": "color",
          "$value": "{color.stone.50}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.97
            }
          },
          "$description": "Opaque header bar (menu open, reduced transparency)."
        }
      },
      "text": {
        "text": {
          "$type": "color",
          "$value": "{site.primitive.palette.gray-950}",
          "$description": "Body text and headlines."
        },
        "text-muted": {
          "$type": "color",
          "$value": "{site.primitive.palette.gray-600}",
          "$description": "Least important readable text: hints, meta lines, timestamps, placeholders (≥ 4.5:1)."
        }
      },
      "accent": {
        "accent": {
          "$type": "color",
          "$value": "{site.primitive.palette.brand-accent-700}",
          "$description": "Brand action colour: primary buttons, selected states, links on controls, focus ring, progress."
        },
        "accent-text": {
          "$type": "color",
          "$value": "{site.primitive.palette.brand-accent-600}",
          "$description": "Accent as text (links, kickers) at ≥ 4.5:1."
        },
        "accent-fill": {
          "$type": "color",
          "$value": "{site.primitive.palette.brand-accent-700}",
          "$description": "Accent button fill."
        },
        "accent-fill-hi": {
          "$type": "color",
          "$value": "{site.primitive.palette.brand-accent-600}",
          "$description": "Accent button fill on hover."
        },
        "on-accent": {
          "$type": "color",
          "$value": "{site.primitive.palette.stone-0}",
          "$description": "Text and icons on an accent fill (primary button, selected pill, active nav item)."
        },
        "highlight": {
          "$type": "color",
          "$value": "{site.primitive.palette.brand-highlight-800}",
          "$description": "Highlight brand colour (second brand colour)."
        },
        "highlight-text": {
          "$type": "color",
          "$value": "{site.primitive.palette.brand-highlight-700}",
          "$description": "Highlight as text at ≥ 4.5:1."
        },
        "highlight-subtle": {
          "$type": "color",
          "$value": "{brand.highlight.750}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.07
            }
          },
          "$description": "Faint highlight tint."
        },
        "highlight-border": {
          "$type": "color",
          "$value": "{brand.highlight.750}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.5
            }
          },
          "$description": "Border in highlight colour."
        }
      },
      "feedback": {
        "danger": {
          "$type": "color",
          "$value": "{site.primitive.palette.red-700}",
          "$description": "Errors and destructive actions on the website."
        }
      },
      "outline": {
        "border-subtle": {
          "$type": "color",
          "$value": "{color.graphite.ink}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.08
            }
          },
          "$description": "Hairline borders and dividers."
        },
        "border-medium": {
          "$type": "color",
          "$value": "{color.graphite.ink}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.14
            }
          },
          "$description": "Borders of chips, pills and fields."
        },
        "border-strong": {
          "$type": "color",
          "$value": "{color.graphite.ink}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.24
            }
          },
          "$description": "Borders that must be seen (focus groups, outlined buttons)."
        }
      },
      "elevation": {
        "shadow-poster": {
          "$type": "shadow",
          "$value": "{color.black}",
          "$extensions": {
            "eu.byphil.ds": {
              "alpha": 0.28
            }
          },
          "$description": "Shadow of video posters and device mocks."
        }
      }
    },
    "component": {}
  }
}
