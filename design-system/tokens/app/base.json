{
  "app": {
    "semantic": {
      "scale": {
        "radius-xs": {
          "$type": "dimension",
          "$value": "6px",
          "$description": "Corner radius 6px: tags, small chips"
        },
        "radius-sheet": {
          "$type": "dimension",
          "$value": "20px",
          "$description": "Corner radius 20px: top corners of bottom sheets"
        },
        "text-scale": {
          "$type": "number",
          "$value": "1",
          "$description": "Multiplier set by Settings › Accessibility › Text size; every fs-* token follows it (WCAG 1.4.4)."
        },
        "fs-2xs": {
          "$type": "dimension",
          "$value": "calc(10px * {app.semantic.scale.text-scale})",
          "$extensions": {
            "eu.byphil.ds": {
              "template": true
            }
          },
          "$description": "Type size 10px × text-scale: labels, bottom nav, badges."
        },
        "fs-xs": {
          "$type": "dimension",
          "$value": "calc(11px * {app.semantic.scale.text-scale})",
          "$extensions": {
            "eu.byphil.ds": {
              "template": true
            }
          },
          "$description": "Type size 11px × text-scale: captions, chips, section captions."
        },
        "fs-sm": {
          "$type": "dimension",
          "$value": "calc(12px * {app.semantic.scale.text-scale})",
          "$extensions": {
            "eu.byphil.ds": {
              "template": true
            }
          },
          "$description": "Type size 12px × text-scale: small buttons, meta lines."
        },
        "fs-md": {
          "$type": "dimension",
          "$value": "calc(13px * {app.semantic.scale.text-scale})",
          "$extensions": {
            "eu.byphil.ds": {
              "template": true
            }
          },
          "$description": "Type size 13px × text-scale: UI body: menus, rows, toasts."
        },
        "fs-base": {
          "$type": "dimension",
          "$value": "calc(14px * {app.semantic.scale.text-scale})",
          "$extensions": {
            "eu.byphil.ds": {
              "template": true
            }
          },
          "$description": "Type size 14px × text-scale: default body text."
        },
        "fs-lg": {
          "$type": "dimension",
          "$value": "calc(16px * {app.semantic.scale.text-scale})",
          "$extensions": {
            "eu.byphil.ds": {
              "template": true
            }
          },
          "$description": "Type size 16px × text-scale: card titles, primary button."
        },
        "fs-xl": {
          "$type": "dimension",
          "$value": "calc(18px * {app.semantic.scale.text-scale})",
          "$extensions": {
            "eu.byphil.ds": {
              "template": true
            }
          },
          "$description": "Type size 18px × text-scale: section titles."
        },
        "fs-2xl": {
          "$type": "dimension",
          "$value": "calc(20px * {app.semantic.scale.text-scale})",
          "$extensions": {
            "eu.byphil.ds": {
              "template": true
            }
          },
          "$description": "Type size 20px × text-scale: screen titles."
        },
        "fs-display": {
          "$type": "dimension",
          "$value": "calc(40px * {app.semantic.scale.text-scale})",
          "$extensions": {
            "eu.byphil.ds": {
              "template": true
            }
          },
          "$description": "Type size 40px × text-scale: the word in the speed reader (Speed-Read, card layout)."
        },
        "fs-display-xl": {
          "$type": "dimension",
          "$value": "calc(64px * {app.semantic.scale.text-scale})",
          "$extensions": {
            "eu.byphil.ds": {
              "template": true
            }
          },
          "$description": "Type size 64px × text-scale: the word in the speed reader in full screen."
        },
        "spacing-s-0": {
          "$type": "dimension",
          "$value": "0",
          "$description": "Spacing step 0 (0) on the 4px grid. Kept for JS inline styles; component CSS uses the same steps."
        },
        "spacing-s-05": {
          "$type": "dimension",
          "$value": "2px",
          "$description": "Spacing step 05 (2px) on the 4px grid. Kept for JS inline styles; component CSS uses the same steps."
        },
        "spacing-s-1": {
          "$type": "dimension",
          "$value": "4px",
          "$description": "Spacing step 1 (4px) on the 4px grid. Kept for JS inline styles; component CSS uses the same steps."
        },
        "spacing-s-2": {
          "$type": "dimension",
          "$value": "8px",
          "$description": "Spacing step 2 (8px) on the 4px grid. Kept for JS inline styles; component CSS uses the same steps."
        },
        "spacing-s-3": {
          "$type": "dimension",
          "$value": "12px",
          "$description": "Spacing step 3 (12px) on the 4px grid. Kept for JS inline styles; component CSS uses the same steps."
        },
        "spacing-s-4": {
          "$type": "dimension",
          "$value": "16px",
          "$description": "Spacing step 4 (16px) on the 4px grid. Kept for JS inline styles; component CSS uses the same steps."
        },
        "spacing-s-5": {
          "$type": "dimension",
          "$value": "20px",
          "$description": "Spacing step 5 (20px) on the 4px grid. Kept for JS inline styles; component CSS uses the same steps."
        },
        "spacing-s-6": {
          "$type": "dimension",
          "$value": "24px",
          "$description": "Spacing step 6 (24px) on the 4px grid. Kept for JS inline styles; component CSS uses the same steps."
        },
        "spacing-s-7": {
          "$type": "dimension",
          "$value": "28px",
          "$description": "Spacing step 7 (28px) on the 4px grid. Kept for JS inline styles; component CSS uses the same steps."
        },
        "spacing-s-8": {
          "$type": "dimension",
          "$value": "32px",
          "$description": "Spacing step 8 (32px) on the 4px grid. Kept for JS inline styles; component CSS uses the same steps."
        },
        "radius-sm": {
          "$type": "dimension",
          "$value": "8px",
          "$description": "Corner radius 8px: icon tiles, menu items, fields"
        },
        "radius-md": {
          "$type": "dimension",
          "$value": "12px",
          "$description": "Corner radius 12px: buttons, chips, rows, segmented controls"
        },
        "radius-lg": {
          "$type": "dimension",
          "$value": "16px",
          "$description": "Corner radius 16px: cards"
        },
        "icon-sm": {
          "$type": "dimension",
          "$value": "14px",
          "$description": "Icon size 14px (inline with small text)."
        },
        "icon-md": {
          "$type": "dimension",
          "$value": "16px",
          "$description": "Icon size 16px (default UI icon)."
        },
        "icon-lg": {
          "$type": "dimension",
          "$value": "20px",
          "$description": "Icon size 20px (settings rows, nav)."
        },
        "icon-xl": {
          "$type": "dimension",
          "$value": "24px",
          "$description": "Icon size 24px (empty states, tiles)."
        },
        "radius-xl": {
          "$type": "dimension",
          "$value": "24px",
          "$description": "Corner radius 24px: input card, large panels"
        },
        "radius-full": {
          "$type": "dimension",
          "$value": "9999px",
          "$description": "Corner radius 9999px: pills and dots"
        }
      },
      "layer": {
        "z-raised": {
          "$type": "number",
          "$value": "20",
          "$description": "Stacking layer 20 for raised. Order: raised < bar < popover < header < nav < fab < float < player < sheet < modal < toast."
        },
        "z-bar": {
          "$type": "number",
          "$value": "25",
          "$description": "Stacking layer 25 for bar. Order: raised < bar < popover < header < nav < fab < float < player < sheet < modal < toast."
        },
        "z-popover": {
          "$type": "number",
          "$value": "50",
          "$description": "Stacking layer 50 for popover. Order: raised < bar < popover < header < nav < fab < float < player < sheet < modal < toast."
        },
        "z-header": {
          "$type": "number",
          "$value": "100",
          "$description": "Stacking layer 100 for header. Order: raised < bar < popover < header < nav < fab < float < player < sheet < modal < toast."
        },
        "z-nav": {
          "$type": "number",
          "$value": "101",
          "$description": "Stacking layer 101 for nav. Order: raised < bar < popover < header < nav < fab < float < player < sheet < modal < toast."
        },
        "z-fab": {
          "$type": "number",
          "$value": "102",
          "$description": "Stacking layer 102 for fab. Order: raised < bar < popover < header < nav < fab < float < player < sheet < modal < toast."
        },
        "z-float": {
          "$type": "number",
          "$value": "240",
          "$description": "Stacking layer 240 for float. Order: raised < bar < popover < header < nav < fab < float < player < sheet < modal < toast."
        },
        "z-player": {
          "$type": "number",
          "$value": "250",
          "$description": "Stacking layer 250 for player. Order: raised < bar < popover < header < nav < fab < float < player < sheet < modal < toast."
        },
        "z-sheet": {
          "$type": "number",
          "$value": "300",
          "$description": "Stacking layer 300 for sheet. Order: raised < bar < popover < header < nav < fab < float < player < sheet < modal < toast."
        },
        "z-modal": {
          "$type": "number",
          "$value": "1000",
          "$description": "Stacking layer 1000 for modal. Order: raised < bar < popover < header < nav < fab < float < player < sheet < modal < toast."
        },
        "z-toast": {
          "$type": "number",
          "$value": "1001",
          "$description": "Stacking layer 1001 for toast. Order: raised < bar < popover < header < nav < fab < float < player < sheet < modal < toast."
        },
        "z-toast-top": {
          "$type": "number",
          "$value": "1100",
          "$description": "Stacking layer 1100 for toast top. Order: raised < bar < popover < header < nav < fab < float < player < sheet < modal < toast."
        }
      },
      "base": {
        "on-solid": {
          "$type": "color",
          "$value": "{color.white}",
          "$description": "Text/icons on a fill that is coloured in every theme (badges, media, the green saved button)."
        },
        "shade": {
          "$type": "color",
          "$value": "{color.black}",
          "$description": "Black for scrims and shadows; always used with an alpha (color-mix)."
        },
        "neutral-tint": {
          "$type": "color",
          "$value": "{color.grey.mid}",
          "$description": "Mid grey, readable as a tint on light and dark surfaces; used with an alpha."
        }
      },
      "feedback": {
        "favorite": {
          "$type": "color",
          "$value": "{color.yellow.400}",
          "$description": "Star / favourite yellow."
        },
        "ok-bright": {
          "$type": "color",
          "$value": "{color.green.500}",
          "$description": "Bright success green for savings, feed badges and progress fills."
        },
        "ok-strong": {
          "$type": "color",
          "$value": "color-mix(in srgb, {app.semantic.feedback.ok} 85%, {app.semantic.base.on-solid})",
          "$description": "Second stop of the success gradient (podcast button).",
          "$extensions": {
            "eu.byphil.ds": {
              "template": true
            }
          }
        },
        "on-warn": {
          "$type": "color",
          "$value": "{color.amber.950}",
          "$description": "Text on a --mood-warn fill."
        }
      },
      "elevation": {
        "elevation-1": {
          "$type": "shadow",
          "$value": "0 2px 8px {color.black@0.1}",
          "$description": "Subtle lift: images, small cards.",
          "$extensions": {
            "eu.byphil.ds": {
              "template": true
            }
          }
        },
        "elevation-2": {
          "$type": "shadow",
          "$value": "0 2px 8px {color.black@0.2}",
          "$description": "Thumbs, floating buttons (second shadow layer).",
          "$extensions": {
            "eu.byphil.ds": {
              "template": true
            }
          }
        },
        "elevation-3": {
          "$type": "shadow",
          "$value": "0 4px 14px {color.black@0.2}",
          "$description": "Raised cards, covers, play button.",
          "$extensions": {
            "eu.byphil.ds": {
              "template": true
            }
          }
        },
        "elevation-4": {
          "$type": "shadow",
          "$value": "0 8px 24px {color.black@0.2}",
          "$description": "Popover menus.",
          "$extensions": {
            "eu.byphil.ds": {
              "template": true
            }
          }
        },
        "elevation-up": {
          "$type": "shadow",
          "$value": "0 -4px 20px {color.black@0.15}",
          "$description": "Panels anchored to the bottom edge.",
          "$extensions": {
            "eu.byphil.ds": {
              "template": true
            }
          }
        }
      },
      "font": {
        "font-ui": {
          "$type": "fontFamily",
          "$value": "{brand.font.app}",
          "$description": "UI typeface of the extension (brand)."
        }
      },
      "surface": {
        "surface-busy": {
          "$type": "color",
          "$value": "{color.neutral.900}",
          "$description": "Summarise button while a request runs."
        },
        "surface-paper": {
          "$type": "color",
          "$value": "{color.white}",
          "$description": "QR codes need a white quiet zone in every theme."
        }
      },
      "focus": {
        "focus-ring": {
          "$type": "color",
          "$value": "{app.semantic.accent.accent}",
          "$description": "Keyboard focus ring. Sits outside the element (offset), so it is always drawn on the surrounding surface: ≥ 3:1 there in every brand × theme (gate). ADR 0005."
        },
        "focus-ring-width": {
          "$type": "dimension",
          "$value": "2px",
          "$description": "Focus ring thickness (WCAG 2.4.13 asks for ≥ 2px)."
        },
        "focus-ring-offset": {
          "$type": "dimension",
          "$value": "2px",
          "$description": "Gap between element and ring: the page colour in the gap is the second colour of the ring (technique C40)."
        },
        "focus-ring-inset": {
          "$type": "dimension",
          "$value": "-2px",
          "$description": "Offset for elements inside a clipped container (menus, toolbars, list rows): the ring is drawn just inside the element."
        }
      },
      "motion": {
        "duration-fast": {
          "$type": "duration",
          "$value": "150ms",
          "$description": "Hover, focus, colour and toggle changes (WCAG: never the only cue)."
        },
        "duration-base": {
          "$type": "duration",
          "$value": "200ms",
          "$description": "Small movements: chips, tab indicator, panels opening in place."
        },
        "duration-slow": {
          "$type": "duration",
          "$value": "300ms",
          "$description": "Larger movements: sheets, cards entering, accordions."
        },
        "duration-slower": {
          "$type": "duration",
          "$value": "400ms",
          "$description": "Travelling elements: nav blob, toasts, flyouts."
        },
        "duration-screen": {
          "$type": "duration",
          "$value": "350ms",
          "$description": "Screen slide between main screen, settings and detail."
        },
        "duration-reveal": {
          "$type": "duration",
          "$value": "500ms",
          "$description": "Content revealed on scroll and hero entrances."
        },
        "easing-standard": {
          "$type": "cubicBezier",
          "$value": "cubic-bezier(0.25, 0.1, 0.25, 1)",
          "$description": "Default curve (same as CSS ease)."
        },
        "easing-decelerate": {
          "$type": "cubicBezier",
          "$value": "cubic-bezier(0, 0, 0.58, 1)",
          "$description": "Things coming to rest: entering elements (CSS ease-out)."
        },
        "easing-accelerate": {
          "$type": "cubicBezier",
          "$value": "cubic-bezier(0.42, 0, 1, 1)",
          "$description": "Things leaving the screen (CSS ease-in)."
        },
        "easing-in-out": {
          "$type": "cubicBezier",
          "$value": "cubic-bezier(0.42, 0, 0.58, 1)",
          "$description": "Back-and-forth and looping movement (CSS ease-in-out)."
        },
        "easing-emphasized": {
          "$type": "cubicBezier",
          "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)",
          "$description": "Appearances that should feel quick and settle softly (sheets, panes)."
        },
        "easing-spring": {
          "$type": "cubicBezier",
          "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)",
          "$description": "Slight overshoot for the nav blob and selection indicators."
        },
        "easing-screen": {
          "$type": "cubicBezier",
          "$value": "cubic-bezier(0.4, 0, 0.2, 1)",
          "$description": "Screen slides."
        }
      },
      "breakpoint": {
        "bp-narrow": {
          "$type": "dimension",
          "$value": "420px",
          "$description": "Narrow popup: rows stack (max-width)."
        },
        "bp-toolbar-compact": {
          "$type": "dimension",
          "$value": "440px",
          "$description": "Article toolbar: back button shows only its icon below this width (JS)."
        },
        "bp-popup": {
          "$type": "dimension",
          "$value": "480px",
          "$description": "Wider than the standard popup: button labels show (min-width 481px)."
        },
        "bp-split": {
          "$type": "dimension",
          "$value": "720px",
          "$description": "Split view: two panes from here (JS, workspaceManager)."
        },
        "bp-card-wide": {
          "$type": "dimension",
          "$value": "760px",
          "$description": "Container query: wide article and source cards."
        },
        "bp-toolbar-labels": {
          "$type": "dimension",
          "$value": "780px",
          "$description": "Article toolbar shows labels next to icons (JS)."
        },
        "bp-settings-wide": {
          "$type": "dimension",
          "$value": "900px",
          "$description": "Settings master–detail: list and panel side by side (JS)."
        },
        "bp-split-3": {
          "$type": "dimension",
          "$value": "1100px",
          "$description": "Split view: three panes from here (JS)."
        }
      }
    },
    "component": {
      "player": {
        "player-cover-from": {
          "$type": "color",
          "$value": "{color.indigo.500}",
          "$extensions": {
            "eu.byphil.ds": {
              "fixed": "decorative placeholder cover, same in every theme"
            }
          }
        },
        "player-cover-to": {
          "$type": "color",
          "$value": "{color.pink.500}",
          "$extensions": {
            "eu.byphil.ds": {
              "fixed": "decorative placeholder cover, same in every theme"
            }
          }
        },
        "player-bg": {
          "$type": "color",
          "$value": "{app.semantic.surface.surface-floating}"
        },
        "player-border": {
          "$type": "color",
          "$value": "{app.semantic.outline.outline-strong}"
        },
        "player-shadow": {
          "$type": "shadow",
          "$value": "{app.semantic.elevation.elevation-sheet}"
        },
        "player-fg": {
          "$type": "color",
          "$value": "{app.semantic.text.text-primary}"
        },
        "player-track": {
          "$type": "color",
          "$value": "{app.semantic.overlay.overlay-strong}"
        },
        "player-fill": {
          "$type": "color",
          "$value": "{app.semantic.accent.accent}"
        },
        "player-hover": {
          "$type": "color",
          "$value": "{app.semantic.overlay.overlay}"
        },
        "player-pill": {
          "$type": "color",
          "$value": "{app.semantic.overlay.overlay}"
        },
        "player-pill-hover": {
          "$type": "color",
          "$value": "{app.semantic.overlay.overlay-strong}"
        },
        "player-play-bg": {
          "$type": "color",
          "$value": "{app.semantic.accent.accent}"
        },
        "player-play-fg": {
          "$type": "color",
          "$value": "{app.semantic.accent.on-accent}"
        },
        "player-cover-bg": {
          "$type": "color",
          "$value": "{app.semantic.surface.surface-track}"
        },
        "player-err": {
          "$type": "color",
          "$value": "{app.semantic.feedback.mood-neg-text}"
        }
      },
      "header": {
        "header-h": {
          "$type": "dimension",
          "$value": "62px"
        }
      },
      "bottom-nav": {
        "bottom-nav-height": {
          "$type": "dimension",
          "$value": "60px"
        },
        "bottom-nav-gap": {
          "$type": "dimension",
          "$value": "0px",
          "$description": "Distance between the bottom dock and the bottom edge of the panel: 0, the dock sits flush (only its top corners are rounded)."
        },
        "bottom-nav-space": {
          "$type": "dimension",
          "$value": "calc({app.component.bottom-nav.bottom-nav-height} + {app.component.bottom-nav.bottom-nav-gap})",
          "$description": "Room the floating dock takes from the bottom (height + gap); use it to place things above the dock.",
          "$extensions": {
            "eu.byphil.ds": {
              "template": true
            }
          }
        }
      },
      "controls": {
        "controls-bottom-gap": {
          "$type": "dimension",
          "$value": "16px"
        },
        "controls-overlay-height": {
          "$type": "dimension",
          "$value": "250px"
        }
      },
      "nav": {
        "nav-clearance": {
          "$type": "dimension",
          "$value": "calc({app.component.bottom-nav.bottom-nav-space} + {app.component.controls.controls-bottom-gap} + {app.semantic.scale.spacing-s-4})",
          "$extensions": {
            "eu.byphil.ds": {
              "template": true
            }
          }
        },
        "nav-bg": {
          "$type": "color",
          "$value": "{app.semantic.surface.surface-bar}"
        },
        "nav-active-text": {
          "$type": "color",
          "$value": "{app.semantic.accent.on-accent}"
        },
        "nav-blob-bg": {
          "$type": "gradient",
          "$value": "linear-gradient(135deg, {app.semantic.accent.accent}, {app.semantic.accent.accent-light})",
          "$extensions": {
            "eu.byphil.ds": {
              "template": true
            }
          }
        }
      },
      "floating": {
        "floating-stack-height": {
          "$type": "dimension",
          "$value": "calc({app.component.bottom-nav.bottom-nav-space} + {app.component.controls.controls-bottom-gap} + {app.component.controls.controls-overlay-height})",
          "$extensions": {
            "eu.byphil.ds": {
              "template": true
            }
          }
        }
      },
      "localsend": {
        "localsend-bg": {
          "$type": "color",
          "$value": "{color.sky.600}",
          "$description": "LocalSend brand blue (third-party mark).",
          "$extensions": {
            "eu.byphil.ds": {
              "fixed": "LocalSend brand colour (third-party mark)"
            }
          }
        }
      },
      "button": {
        "button-working-bg": {
          "$type": "color",
          "$value": "{app.semantic.surface.surface-busy}"
        }
      },
      "qr": {
        "qr-bg": {
          "$type": "color",
          "$value": "{app.semantic.surface.surface-paper}"
        }
      },
      "slider": {
        "slider-track": {
          "$type": "color",
          "$value": "{app.semantic.control.control-track}"
        },
        "slider-fill": {
          "$type": "color",
          "$value": "{app.semantic.accent.accent}"
        }
      },
      "scrollbar": {
        "scrollbar-thumb": {
          "$type": "color",
          "$value": "{app.semantic.control.control-thumb}"
        },
        "scrollbar-thumb-hover": {
          "$type": "color",
