{
  "$description": "Where the generated tokens go. Each output is a marked region in a stylesheet (/* @tokens:start <name> */ … /* @tokens:end <name> */); each block lists the token files whose tokens it declares, in cascade order. `stacks` say which files are in effect in a theme, for the contrast gate, Figma and Android. defaultBrand is the brand the source stylesheets are written in (Kaivo); a context can override it (the website stays AISH until it is rebranded). Builds of a brand rewrite the regions for that brand: the AISH build (plugin/scripts/build.js) puts the AISH blue back.",
  "defaultBrand": "kaivo",
  "contexts": {
    "app": {
      "label": "Extension (popup, side panel, reader)",
      "stacks": {
        "light": [
          "app/base",
          "app/light"
        ],
        "dark": [
          "app/base",
          "app/light",
          "app/dark",
          "app/dark-forced"
        ],
        "contrast": [
          "app/base",
          "app/light",
          "app/contrast"
        ],
        "postil": [
          "app/base",
          "app/light",
          "app/postil"
        ],
        "postil-dark": [
          "app/base",
          "app/light",
          "app/dark",
          "app/dark-forced",
          "app/postil-dark"
        ],
        "contrast-dark": [
          "app/base",
          "app/light",
          "app/dark",
          "app/dark-forced",
          "app/contrast-dark"
        ],
        "postil-tint": [
          "app/base",
          "app/light",
          "app/postil",
          "app/postil-tint"
        ],
        "postil-tint-dark": [
          "app/base",
          "app/light",
          "app/dark",
          "app/dark-forced",
          "app/postil-dark",
          "app/postil-tint-dark"
        ]
      },
      "defaultBrand": "kaivo"
    },
    "site": {
      "label": "Website",
      "stacks": {
        "dark": [
          "site/base",
          "site/dark"
        ],
        "light": [
          "site/base",
          "site/dark",
          "site/light"
        ]
      },
      "scopedStacks": {
        "mock": {
          "light": [
            "site/mock/light"
          ],
          "dark": [
            "site/mock/light",
            "site/mock/dark"
          ]
        },
        "photo": {
          "dark": [
            "site/photo/dark"
          ],
          "light": [
            "site/photo/dark",
            "site/photo/light"
          ]
        }
      },
      "defaultBrand": "aish"
    }
  },
  "outputs": [
    {
      "file": "plugin/src/styles.css",
      "brandBuildPath": "styles.css",
      "region": "theme",
      "context": "app",
      "blocks": [
        {
          "selector": ":root,\n:root[data-theme='light']",
          "sets": [
            "app/base",
            "app/light"
          ]
        },
        {
          "comment": "colour schemes: Settings › Appearance › Color scheme (data-scheme: aish, kaivo, viola). Brand schemes emit only the colours that differ from this build's brand; they come right after the light block so the dark blocks below still win. Design (data-design: postil, contrast) and brightness (data-theme: light, dark) are separate axes.",
          "scheme": "aish",
          "selector": ":root[data-scheme='aish']",
          "sets": [
            "app/base",
            "app/light"
          ]
        },
        {
          "scheme": "kaivo",
          "selector": ":root[data-scheme='kaivo']",
          "sets": [
            "app/base",
            "app/light"
          ]
        },
        {
          "scheme": "viola",
          "selector": ":root[data-scheme='viola']",
          "sets": [
            "app/base",
            "app/light"
          ]
        },
        {
          "scheme": "graphite",
          "selector": ":root[data-scheme='graphite']",
          "sets": [
            "app/base",
            "app/light"
          ]
        },
        {
          "comment": "Design Postil: e-reader look, off-white paper and graphite ink, flat (light)",
          "selector": ":root[data-design='postil']",
          "sets": [
            "app/postil"
          ],
          "extra": [
            "color-scheme: light"
          ]
        },
        {
          "comment": "Postil tinted with a colour scheme: the same paper and ink, a few percent of the brand colour in the surfaces and the brand accent (tools/postil-tints.mjs).",
          "tint": "kaivo",
          "selector": ":root[data-design='postil'][data-scheme='kaivo']",
          "sets": [
            "app/postil-tint"
          ]
        },
        {
          "comment": "Postil tinted with a colour scheme: the same paper and ink, a few percent of the brand colour in the surfaces and the brand accent (tools/postil-tints.mjs).",
          "tint": "aish",
          "selector": ":root[data-design='postil'][data-scheme='aish']",
          "sets": [
            "app/postil-tint"
          ]
        },
        {
          "comment": "Postil tinted with a colour scheme: the same paper and ink, a few percent of the brand colour in the surfaces and the brand accent (tools/postil-tints.mjs).",
          "tint": "viola",
