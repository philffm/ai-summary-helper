{
  "$description": "Where the generated tokens go. Each output is a marked region in a stylesheet (/* @tokens:start <name> */ … /* @tokens:end <name> */); each block lists the token files whose tokens it declares, in cascade order. `stacks` say which files are in effect in a theme, for the contrast gate, Figma and Android.",
  "defaultBrand": "aish",
  "contexts": {
    "app": {
      "label": "Extension (popup, side panel, reader)",
      "stacks": {
        "light": [
          "app/base",
          "app/light"
        ],
        "dark": [
          "app/base",
          "app/light",
          "app/dark",
          "app/dark-forced"
        ],
        "contrast": [
          "app/base",
          "app/light",
          "app/contrast"
        ]
      }
    },
    "site": {
      "label": "Website",
      "stacks": {
        "dark": [
          "site/base",
          "site/dark"
        ],
        "light": [
          "site/base",
          "site/dark",
          "site/light"
        ]
      },
      "scopedStacks": {
        "mock": {
          "light": [
            "site/mock/light"
          ],
          "dark": [
            "site/mock/light",
            "site/mock/dark"
          ]
        },
        "photo": {
          "dark": [
            "site/photo/dark"
          ],
          "light": [
            "site/photo/dark",
            "site/photo/light"
          ]
        }
      }
    }
  },
  "outputs": [
    {
      "file": "plugin/src/styles.css",
      "brandBuildPath": "styles.css",
      "region": "theme",
      "context": "app",
      "blocks": [
        {
          "selector": ":root,\n:root[data-theme='light']",
          "sets": [
            "app/base",
            "app/light"
          ]
        },
        {
          "media": "(prefers-color-scheme: dark)",
          "selector": ":root:not([data-theme='light']):not([data-theme='contrast'])",
          "sets": [
            "app/dark"
          ]
        },
        {
          "selector": ":root[data-theme='dark']",
          "sets": [
            "app/dark",
            "app/dark-forced"
          ]
        },
        {
          "selector": ":root[data-theme='contrast']",
          "sets": [
            "app/contrast"
          ],
          "extra": [
            "color-scheme: light"
          ]
        },
        {
          "comment": "reduced motion: system setting",
          "media": "(prefers-reduced-motion: reduce)",
          "selector": ":root",
          "sets": [
            "app/reduced-motion"
          ]
        },
        {
          "comment": "reduced motion: Settings › Accessibility",
          "selector": "html[data-motion='reduce']",
          "sets": [
            "app/reduced-motion"
          ]
        }
      ]
    },
    {
      "file": "plugin/src/inPage.css",
      "brandBuildPath": "inPage.css",
      "region": "theme",
      "context": "app",
      "blocks": [
        {
          "selector": ":host,\n:host([data-theme='light'])",
          "sets": [
            "app/base",
            "app/light"
          ]
        },
        {
          "media": "(prefers-color-scheme: dark)",
          "selector": ":host(:not([data-theme='light']):not([data-theme='contrast']))",
          "sets": [
            "app/dark"
          ]
        },
        {
          "selector": ":host([data-theme='dark'])",
          "sets": [
            "app/dark",
            "app/dark-forced"
          ]
        },
        {
          "selector": ":host([data-theme='contrast'])",
          "sets": [
            "app/contrast"
          ]
        },
        {
          "media": "(prefers-reduced-motion: reduce)",
          "selector": ":host",
          "sets": [
            "app/reduced-motion"
          ]
        },
        {
          "selector": ":host([data-motion='reduce'])",
          "sets": [
            "app/reduced-motion"
          ]
        }
      ]
    },
    {
      "file": "docs/assets/styles.css",
      "brandBuildPath": "assets/styles.css",
      "region": "theme",
      "context": "site",
      "blocks": [
        {
          "selector": ":root",
          "sets": [
            "site/base"
          ]
        },
        {
          "comment": "roles: dark (also the default before the theme script has run)",
          "selector": ":root,\n:root[data-theme=\"dark\"]",
          "sets": [
            "site/dark"
          ],
          "extra": [
            "color-scheme:dark"
          ]
        },
        {
          "selector": ":root[data-theme=\"light\"]",
          "sets": [
            "site/light"
          ],
          "extra": [
            "color-scheme:light"
          ]
        },
        {
          "comment": "reduced motion: system setting",
          "media": "(prefers-reduced-motion: reduce)",
          "selector": ":root",
          "sets": [
            "site/reduced-motion"
          ]
        }
      ]
    },
    {
      "file": "docs/assets/styles.css",
      "brandBuildPath": "assets/styles.css",
      "region": "mock",
      "context": "site",
      "blocks": [
        {
          "comment": "Hero mock of the extension: its own small palette as component tokens on the scene, light first, dark below. The mock rules read only these.",
          "selector": ":is(.hero-scene, .hscene)",
          "sets": [
            "site/mock/light"
          ]
        },
        {
          "media": "(max-width:900px)",
          "selector": ":is(.hero-scene, .hscene)",
          "sets": [
            "site/mock/narrow"
          ]
        },
        {
          "selector": ":root[data-theme=\"dark\"] :is(.hero-scene, .hscene)",
          "sets": [
            "site/mock/dark"
          ]
        }
      ]
    },
    {
      "file": "docs/assets/styles.css",
      "brandBuildPath": "assets/styles.css",
      "region": "photo",
      "context": "site",
      "blocks": [
        {
          "comment": "Photo stage (home hero, blog post header): dark veil and light text by default, light veil and role colours in the light theme.",
          "selector": ".hero--photo",
          "sets": [
            "site/photo/dark"
          ]
        },
        {
          "selector": ":root[data-theme=\"light\"] .hero--photo",
          "sets": [
            "site/photo/light"
          ]
        }
      ]
    }
  ],
