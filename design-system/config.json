  "runtimeTokens": {
    "$description": "Set per element by script or style attribute, so the stylesheet reads them without defining them.",
    "app": [
      "--mood-tint",
      "--mood-bar"
    ],
    "site": [
      "--img",
      "--s",
      "--cw",
      "--ch",
      "--p-a",
      "--p-sugg",
      "--p-panel",
      "--p-hl",
      "--p-qa",
      "--p-graph",
      "--i",
      "--ds",
      "--fw",
      "--fh",
      "--bgpos",
      "--dw"
    ]
  },
  "offScaleBreakpoints": {
    "$description": "Media/container widths not (yet) on the breakpoint scale; lint.mjs fails on any new one. Shrink this list when a layout is moved to a token value (a visible change). ADR 0005.",
    "app": [],
    "site": [
      520,
      600,
      700,
      820,
      960,
      1180
    ]
  }
