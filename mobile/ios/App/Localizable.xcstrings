    "Connecting only fetches. Writing back stays off until you switch it on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الاتصال يجلب فقط. تبقى الكتابة العكسية متوقفة حتى تشغّلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beim Verbinden wird nur geholt. Zurückschreiben bleibt aus, bis du es einschaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al conectar solo se descarga. La escritura de vuelta queda desactivada hasta que la actives."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhdistäminen vain hakee. Takaisin kirjoittaminen on pois, kunnes otat sen käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connexion ne fait que récupérer. La réécriture reste désactivée tant que vous ne l’activez pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "接続しただけでは取得のみです。書き戻しはオンにするまで無効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "연결하면 가져오기만 합니다. 다시 쓰기는 켜기 전까지 꺼져 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conectar só busca. A gravação de volta fica desligada até você ativar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подключение только загружает. Обратная запись выключена, пока вы её не включите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Підключення лише завантажує. Зворотний запис вимкнено, доки ви його не ввімкнете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "连接后只会获取。回写在你开启前保持关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "連接後只會取得。回寫在你開啟前保持關閉。"
          }
        }
      }
    },
    "Connecting replaces the library you are connected to now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سيحل الاتصال محل المكتبة المتصلة حاليًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Verbinden ersetzt die jetzt verbundene Bibliothek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al conectar se sustituye la biblioteca conectada ahora."
          }
        },
        "fi": {
          "stringUnit": {
