    "Allow it on websites, then open an article and tap the page menu in the address bar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اسمح له بالعمل على المواقع، ثم افتح مقالة واضغط على قائمة الصفحة في شريط العنوان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaube es auf Websites, öffne dann einen Artikel und tippe auf das Seitenmenü in der Adressleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permítelo en los sitios web, abre un artículo y toca el menú de página en la barra de direcciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salli se verkkosivuilla, avaa sitten artikkeli ja napauta osoiterivin sivuvalikkoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorisez-le sur les sites web, puis ouvrez un article et touchez le menu de page dans la barre d’adresse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Webサイトでの利用を許可し、記事を開いてアドレスバーのページメニューをタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "웹사이트에서 허용한 뒤 글을 열고 주소 막대의 페이지 메뉴를 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permita-o nos sites, depois abra um artigo e toque no menu da página na barra de endereço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разрешите его на сайтах, затем откройте статью и нажмите меню страницы в адресной строке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дозвольте його на сайтах, потім відкрийте статтю й торкніться меню сторінки в адресному рядку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允许它访问网站，然后打开文章并轻点地址栏中的页面菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允許它存取網站，然後打開文章並點一下網址列中的頁面選單。"
          }
        }
      }
    },
