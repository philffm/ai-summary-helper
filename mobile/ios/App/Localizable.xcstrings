    "During deep sleep the brain goes over the day again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "في النوم العميق يستعيد الدماغ أحداث اليوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Im Tiefschlaf geht das Gehirn den Tag noch einmal durch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En el sueño profundo el cerebro repasa el día."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Syvän unen aikana aivot käyvät päivän uudelleen läpi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pendant le sommeil profond, le cerveau repasse la journée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "深い眠りの中で、脳は一日をもう一度たどります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "깊은 잠에서 뇌는 하루를 다시 되짚습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No sono profundo o cérebro repassa o dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В глубоком сне мозг заново проходит прожитый день."
