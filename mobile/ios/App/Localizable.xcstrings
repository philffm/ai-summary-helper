    "Articles, PDFs and videos, with the AI model you choose.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "المقالات وملفات PDF والفيديوهات، بنموذج الذكاء الاصطناعي الذي تختاره."
          }
        },
        "de": {
