    "Choose a model in Kaivo in Safari, then open any page there: the app takes it over.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر نموذجًا في Kaivo داخل Safari، ثم افتح أي صفحة هناك: سيأخذه التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähle in Kaivo in Safari ein Modell und öffne dort eine Seite: Die App übernimmt es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige un modelo en Kaivo en Safari y abre allí cualquier página: la app lo adopta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valitse malli Kaivossa Safarissa ja avaa siellä jokin sivu: sovellus ottaa sen käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez un modèle dans Kaivo sur Safari, puis ouvrez-y une page : l’app le reprend."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SafariのKaivoでモデルを選び、ページを開くと、アプリが引き継ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari의 Kaivo에서 모델을 고른 뒤 아무 페이지나 열면 앱이 이어받습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha um modelo no Kaivo no Safari e abra qualquer página: o app passa a usá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выберите модель в Kaivo в Safari и откройте там любую страницу: приложение возьмёт её."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виберіть модель у Kaivo в Safari й відкрийте там будь-яку сторінку: застосунок перейме її."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 Safari 的 Kaivo 中选择模型，然后打开任意网页，应用即会沿用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 Safari 的 Kaivo 中選擇模型，然後打開任一網頁，App 便會沿用。"
          }
        }
      }
    },
