        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "요약을 위해 Kaivo는 이 글의 텍스트를 %@(으)로 보냅니다. 허용하기 전에는 아무것도 보내지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para escrever o resumo, o Kaivo envia o texto deste artigo para %@. Nada é enviado antes da sua permissão."
