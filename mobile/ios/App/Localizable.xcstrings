          }
        }
      }
    },
    "Open an article in Safari, tap the page menu in the address bar and choose Kaivo.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "افتح مقالة في Safari، واضغط على قائمة الصفحة في شريط العنوان واختر Kaivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffne einen Artikel in Safari, tippe auf das Seitenmenü in der Adressleiste und wähle Kaivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre un artículo en Safari, toca el menú de página en la barra de direcciones y elige Kaivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avaa artikkeli Safarissa, napauta osoiterivin sivuvalikkoa ja valitse Kaivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvrez un article dans Safari, touchez le menu de page dans la barre d’adresse et choisissez Kaivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safariで記事を開き、アドレスバーのページメニューをタップしてKaivoを選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Safari에서 글을 열고 주소 막대의 페이지 메뉴를 눌러 Kaivo를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra um artigo no Safari, toque no menu da página na barra de endereço e escolha Kaivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте статью в Safari, нажмите меню страницы в адресной строке и выберите Kaivo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкрийте статтю в Safari, торкніться меню сторінки в адресному рядку та виберіть Kaivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 Safari 中打开文章，轻点地址栏中的页面菜单，然后选择 Kaivo。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 Safari 中打開文章，點一下網址列中的頁面選單，然後選擇 Kaivo。"
          }
        }
      }
    },
