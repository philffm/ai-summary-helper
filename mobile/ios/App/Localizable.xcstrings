    "Choose a model in Kaivo in Safari, then open any page there: the app takes it over.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر نموذجًا في Kaivo داخل Safari، ثم افتح أي صفحة هناك: سيأخذه التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähle in Kaivo in Safari ein Modell und öffne dort eine Seite: Die App übernimmt es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige un modelo en Kaivo en Safari y abre allí cualquier página: la app lo adopta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valitse malli Kaivossa Safarissa ja avaa siellä jokin sivu: sovellus ottaa sen käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez un modèle dans Kaivo sur Safari, puis ouvrez-y une page : l’app le reprend."
