    "Highlights, notes and saved questions appear here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تظهر هنا التظليلات والملاحظات والأسئلة المحفوظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markierungen, Notizen und gespeicherte Fragen erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aquí aparecen los destacados, las notas y las preguntas guardadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Korostukset, muistiinpanot ja tallennetut kysymykset näkyvät täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les surlignages, les notes et les questions enregistrées apparaissent ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ハイライト、メモ、保存した質問がここに表示されます。"
          }
