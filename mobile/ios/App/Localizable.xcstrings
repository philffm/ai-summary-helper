          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "연결하면 지금 연결된 보관함이 바뀝니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
