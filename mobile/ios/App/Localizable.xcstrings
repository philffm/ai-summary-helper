          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désactivé : l’app ne fait que récupérer. Activé : la progression, les surlignages, commentaires, notes et questions de votre bibliothèque vont aussi vers votre espace, y compris vos changements antérieurs."
          }
        },
        "ja": {
