    "Sleep helps what you have read to stay.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "النوم يساعد على تثبيت ما قرأته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schlaf hilft, Gelesenes zu behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El sueño ayuda a que lo leído permanezca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uni auttaa lukemaasi pysymään mielessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le sommeil aide à retenir ce que l’on a lu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "睡眠は読んだ内容の定着を助けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "잠은 읽은 것이 남도록 돕습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O sono ajuda a fixar o que foi lido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сон помогает удержать прочитанное."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сон допомагає запам’ятати прочитане."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
