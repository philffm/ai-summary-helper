    "Software that keeps its data on your device keeps working when a service changes or closes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "البرمجيات التي تحفظ بياناتها على جهازك تستمر في العمل حين تتغير خدمة أو تُغلق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Software, die ihre Daten auf deinem Gerät hält, läuft weiter, wenn sich ein Dienst ändert oder schließt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El software que guarda sus datos en tu dispositivo sigue funcionando cuando un servicio cambia o cierra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiedot laitteellasi pitävä ohjelmisto toimii, vaikka palvelu muuttuu tai suljetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un logiciel qui garde ses données sur votre appareil continue de fonctionner quand un service change ou ferme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "データを手元に置くソフトは、サービスが変わっても終了しても使い続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "데이터를 기기에 두는 소프트웨어는 서비스가 바뀌거나 문을 닫아도 계속 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O software que guarda os dados no seu dispositivo continua funcionando quando um serviço muda ou fecha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Программа, хранящая данные на вашем устройстве, работает, даже если сервис меняется или закрывается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Програма, що зберігає дані на вашому пристрої, працює, навіть якщо сервіс змінюється чи закривається."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "把数据留在设备上的软件，即使服务变更或关闭也能继续使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
