          }
        }
      }
    },
    "Sleep moves what you read today into what you know next week.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "النوم ينقل ما قرأته اليوم إلى ما تعرفه الأسبوع المقبل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schlaf macht aus dem, was du heute liest, das, was du nächste Woche weißt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El sueño convierte lo que lees hoy en lo que sabrás la semana que viene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uni muuttaa tänään lukemasi ensi viikolla tietämäksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le sommeil transforme ce que vous lisez aujourd’hui en ce que vous saurez la semaine prochaine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "眠りは、今日読んだことを来週の知識に変えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "잠은 오늘 읽은 것을 다음 주의 지식으로 바꿉니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
