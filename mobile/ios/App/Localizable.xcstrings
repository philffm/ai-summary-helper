    "A short review the next day adds to it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ومراجعة قصيرة في اليوم التالي تزيد من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein kurzer Rückblick am nächsten Tag verstärkt das."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un breve repaso al día siguiente lo refuerza."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lyhyt kertaus seuraavana päivänä vahvistaa sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une brève révision le lendemain le renforce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "翌日の短い振り返りがそれを後押しします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다음 날의 짧은 복습이 효과를 더합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma revisão curta no dia seguinte reforça isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Короткое повторение на следующий день усиливает эффект."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Коротке повторення наступного дня посилює ефект."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "第二天简短回顾效果更好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "第二天簡短回顧效果更好。"
          }
        }
      }
    },
    "A short review the next morning keeps more than a second reading the same evening.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مراجعة قصيرة في صباح اليوم التالي تُبقي أكثر من قراءة ثانية في المساء نفسه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein kurzer Rückblick am nächsten Morgen behält mehr als ein zweites Lesen am selben Abend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un breve repaso a la mañana siguiente retiene más que una segunda lectura esa misma noche."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lyhyt kertaus seuraavana aamuna jää mieleen paremmin kuin toinen lukukerta samana iltana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une brève révision le lendemain matin retient plus qu’une seconde lecture le soir même."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "翌朝の短い振り返りは、同じ晩の再読より記憶に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
