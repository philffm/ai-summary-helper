            "value": "你的一則重點標示，缺一個詞"
          }
        }
      }
    },
    "One of your highlights.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إحدى تظليلاتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine deiner Markierungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uno de tus resaltados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yksi korostuksistasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’un de vos surlignages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "あなたのハイライトから一つ。"
          }
        },
        "ko": {
          "stringUnit": {
