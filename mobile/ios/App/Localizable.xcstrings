        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "하이라이트, 메모, 저장한 질문이 여기에 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
