    "What is only saved on this iPhone stays here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ما هو محفوظ على هذا الـiPhone فقط يبقى هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Was nur auf diesem iPhone gespeichert ist, bleibt hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo guardado solo en este iPhone se queda aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vain tähän iPhoneen tallennettu pysyy täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce qui n’est enregistré que sur cet iPhone y reste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このiPhoneだけに保存したものはここに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 iPhone에만 저장한 것은 여기에 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O que está salvo só neste iPhone fica aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "То, что сохранено только на этом iPhone, остаётся здесь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Те, що збережено лише на цьому iPhone, лишається тут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅保存在此 iPhone 上的内容会留在本机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "僅儲存在此 iPhone 的內容會留在本機。"
          }
        }
      }
    },
    "What you read and mark here stays on this device for now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ما تقرؤه وتظلله هنا يبقى على هذا الجهاز حاليًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Was du hier liest und markierst, bleibt vorerst auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo que lees y marcas aquí se queda por ahora en este dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mitä täällä luet ja merkitset, pysyy toistaiseksi tällä laitteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce que tu lis et surlignes ici reste pour l’instant sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ここで読んだ内容や付けたハイライトは、今のところこの端末にのみ残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "여기서 읽고 표시한 내용은 지금은 이 기기에만 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O que você lê e marca aqui fica por enquanto neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Прочитанное и выделенное здесь пока остаётся на этом устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Прочитане й виділене тут поки лишається на цьому пристрої."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你在这里阅读和标记的内容目前只保留在本设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你在這裡閱讀和標記的內容目前只保留在本裝置上。"
          }
        }
