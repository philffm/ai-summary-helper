        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiivistelmää varten Kaivo lähettää tämän artikkelin tekstin vastaanottajalle %@. Mitään ei lähetetä ennen lupaasi."
          }
        },
        "fr": {
          "stringUnit": {
