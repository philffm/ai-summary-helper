    "Switch it on in Settings → Apple Intelligence & Siri. The device then fetches the model.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "شغّله من الإعدادات ← Apple Intelligence وSiri. ثم ينزّل الجهاز النموذج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Einschalten unter Einstellungen → Apple Intelligence & Siri. Danach lädt das Gerät das Modell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Actívalo en Ajustes → Apple Intelligence y Siri. Después el dispositivo descarga el modelo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ota käyttöön: Asetukset → Apple Intelligence ja Siri. Sen jälkeen laite lataa mallin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activez-le dans Réglages → Apple Intelligence et Siri. L’appareil télécharge ensuite le modèle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設定 → Apple IntelligenceとSiriでオンにしてください。その後モデルがダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "설정 → Apple Intelligence 및 Siri에서 켜세요. 그러면 기기가 모델을 내려받습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ative em Ajustes → Apple Intelligence e Siri. Depois o dispositivo baixa o modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Включите в Настройках → Apple Intelligence и Siri. После этого устройство загрузит модель."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Увімкніть у Параметрах → Apple Intelligence та Siri. Після цього пристрій завантажить модель."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在“设置”→“Apple 智能与 Siri”中开启。之后设备会下载模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在「設定」→「Apple Intelligence 與 Siri」中開啟。之後裝置會下載模型。"
          }
        }
      }
    },
