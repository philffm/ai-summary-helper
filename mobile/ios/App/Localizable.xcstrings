    "The alarm could not be set. Check that Kaivo may use alarms.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر ضبط المنبّه. تحقّق من السماح لـ Kaivo باستخدام المنبّهات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Wecker ließ sich nicht stellen. Prüfe, ob Kaivo Wecker nutzen darf."
          }
        },
        "es": {
