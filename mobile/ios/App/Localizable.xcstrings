    "Lock the phone now to see it as in the morning.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اقفل الهاتف الآن لتراه كما في الصباح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sperr das Telefon jetzt, um es wie am Morgen zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloquea ahora el teléfono para verlo como por la mañana."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lukitse puhelin nyt, niin näet sen kuten aamulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verrouillez le téléphone pour le voir comme le matin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "今ロックすると朝と同じように表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "지금 잠그면 아침처럼 볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloqueie o telefone agora para ver como de manhã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заблокируйте телефон, чтобы увидеть как утром."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заблокуйте телефон, щоб побачити як уранці."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "现在锁定手机，即可看到早晨的效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "現在鎖定手機，即可看到早晨的效果。"
          }
        }
      }
    },
    "Mark a passage and find it again with its source.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ظلّل فقرة وارجع إليها مع مصدرها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markiere eine Stelle und finde sie mit ihrer Quelle wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Marca un pasaje y vuelve a encontrarlo con su fuente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Merkitse kohta ja löydä se uudelleen lähteineen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Surlignez un passage et retrouvez-le avec sa source."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一節にマークして、出典とともに見つけ直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "문단에 표시하고 출처와 함께 다시 찾으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Marque um trecho e reencontre-o com a fonte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выделите фрагмент и найдите его снова вместе с источником."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виділіть уривок і знайдіть його знову разом із джерелом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "标记段落，并连同来源再次找到它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "標記段落，並連同來源再次找到它。"
          }
        }
      }
    },
