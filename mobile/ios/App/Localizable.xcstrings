    "Lock the phone now to see it as in the morning.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اقفل الهاتف الآن لتراه كما في الصباح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sperr das Telefon jetzt, um es wie am Morgen zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloquea ahora el teléfono para verlo como por la mañana."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lukitse puhelin nyt, niin näet sen kuten aamulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
