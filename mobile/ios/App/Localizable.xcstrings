    "Sleep helps what you have read to stay.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "النوم يساعد على تثبيت ما قرأته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schlaf hilft, Gelesenes zu behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El sueño ayuda a que lo leído permanezca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uni auttaa lukemaasi pysymään mielessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le sommeil aide à retenir ce que l’on a lu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "睡眠は読んだ内容の定着を助けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "잠은 읽은 것이 남도록 돕습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O sono ajuda a fixar o que foi lido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сон помогает удержать прочитанное."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сон допомагає запам’ятати прочитане."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "睡眠有助于记住读过的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "睡眠有助於記住讀過的內容。"
          }
        }
      }
    },
    "Sleep moves what you read today into what you know next week.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "النوم ينقل ما قرأته اليوم إلى ما تعرفه الأسبوع المقبل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schlaf macht aus dem, was du heute liest, das, was du nächste Woche weißt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El sueño convierte lo que lees hoy en lo que sabrás la semana que viene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uni muuttaa tänään lukemasi ensi viikolla tietämäksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le sommeil transforme ce que vous lisez aujourd’hui en ce que vous saurez la semaine prochaine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "眠りは、今日読んだことを来週の知識に変えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "잠은 오늘 읽은 것을 다음 주의 지식으로 바꿉니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O sono transforma o que você lê hoje no que saberá na semana que vem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сон превращает прочитанное сегодня в то, что вы будете знать через неделю."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сон перетворює прочитане сьогодні на те, що ви знатимете за тиждень."
          }
        },
        "zh-Hans": {
          "stringUnit": {
