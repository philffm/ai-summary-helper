            "value": "설정 → 앱 → Safari → 확장 프로그램을 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra Ajustes → Apps → Safari → Extensões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте «Настройки» → «Приложения» → Safari → «Расширения»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкрийте «Параметри» → «Програми» → Safari → «Розширення»."
          }
        },
        "zh-Hans": {
