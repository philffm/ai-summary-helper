    "Mark a passage and find it again with its source.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ظلّل فقرة وارجع إليها مع مصدرها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markiere eine Stelle und finde sie mit ihrer Quelle wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Marca un pasaje y vuelve a encontrarlo con su fuente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Merkitse kohta ja löydä se uudelleen lähteineen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Surlignez un passage et retrouvez-le avec sa source."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一節にマークして、出典とともに見つけ直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "문단에 표시하고 출처와 함께 다시 찾으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Marque um trecho e reencontre-o com a fonte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выделите фрагмент и найдите его снова вместе с источником."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виділіть уривок і знайдіть його знову разом із джерелом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "标记段落，并连同来源再次找到它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "標記段落，並連同來源再次找到它。"
          }
        }
      }
    },
