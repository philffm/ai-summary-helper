// The one place for the bundle id. The extension's id is this plus ".extension".
// It can no longer change once an app with this id has been submitted to App Store Connect.
KAIVO_BUNDLE_ID = eu.byphil.kaivo
// The app's icon and name on the home screen. Test builds take others, so that they are told apart from the store's app:
// scripts/upload-testflight.sh sets AppIcon-Beta, a device build with a test id sets AppIcon-Dev (Local.xcconfig).
KAIVO_ICON = AppIcon
KAIVO_NAME = Kaivo
// Shared between the app and the widgets (and later the Safari extension).
KAIVO_APP_GROUP = group.$(KAIVO_BUNDLE_ID)

// Written by scripts/version.sh from current_version.json (not committed).
#include? "Version.xcconfig"
// Your signing team and other local overrides (not committed): see Local.xcconfig.example.
#include? "Local.xcconfig"

// The longer sample stories are for debug builds (screenshots, videos); a release does not carry them.
EXCLUDED_SOURCE_FILE_NAMES[config=Release] = stories.*.json
